@using SanyTotalWar.Wasm.Services
@inject UiState Ui

@if (Ui.ShowBriefing)
{
    <div class="modal-back" @onclick="() => Ui.ShowBriefing = false">
        <div class="modal panel" @onclick:stopPropagation="true">
            <div class="modal-title">ОПЕРАТИВНЫЙ БРИФИНГ</div>

            <div class="brief-columns">
                <div class="brief-col">
                    <div class="panel-sub">УПРАВЛЕНИЕ</div>
                    <ul class="brief-list">
                        <li><b>ЛКМ (зажать)</b> — ведёте маршрут: армия пополняется за ход (UC-02)</li>
                        <li><b>Замкнутая петля</b> — захват нейтральных земель (UC-01), атака чужих (UC-06), вступление в чужую войну (UC-07)</li>
                        <li><b>Дуга от своей границы</b> — светлние земли растут без петли: ведите маршрут из-за пределов своей земли и верните конец к её границе; земля вливается автоматически (UC-01/04)</li>
                        <li>Смежные свои земли сливаются сами при касании (UC-04)</li>
                        <li><b>ПКМ (зажать)</b> — панорама карты, <b>колесо</b> — зум с детализацией тайлов</li>
                        <li>Заходите в точки контроля в зоне войны — очки (UC-10.5)</li>
                    </ul>

                    <div class="panel-sub">ПРАВИЛА</div>
                    <ul class="brief-list">
                        <li>Лимит армии растёт от площади территории (UC-03)</li>
                        <li>Смежные участки сливаются в одну землю (UC-04)</li>
                        <li>Война: 24 ч с последнего вступления; побеждает C = 0.5·H + 0.5·S (UC-11/12)</li>
                        <li>Если война вырезает середину земли — она распадается, армия делится пропорционально площади (UC-05)</li>
                        <li>Подкрепления — из смежных земель, отступление теряет 50% (UC-08/09)</li>
                        <li>Каждый день −5% лимита армии на содержание (UC-14)</li>
                    </ul>
                </div>

                <div class="brief-col">
                    <div class="panel-sub">ПОСТРОЙКИ (UC-13)</div>
                    <ul class="brief-list">
                        <li><b>Военкомат</b> — 300 · +20% войск за ходьбу</li>
                        <li><b>Крепость</b> — 500 · +20% сила обороны рядом (не стакается)</li>
                        <li><b>Аэропорт</b> — 1000 · переброска войск на любую свою землю</li>
                        <li><b>Казармы</b> — 500 · пассивный распад армии −50%</li>
                    </ul>

                    <div class="panel-sub">ВРЕМЯ</div>
                    <ul class="brief-list">
                        <li>Симуляция ускорена: ×60 по умолчанию (1 с = 1 ч игры)</li>
                        <li>Волны точек контроля — каждые 12 ч войны (UC-10.5)</li>
                        <li>Соседи живут своей жизнью: расширяются и нападают</li>
                    </ul>
                </div>
            </div>

            <button class="btn primary big" @onclick="() => Ui.ShowBriefing = false">ПРИНЯТЬ КОМАНДОВАНИЕ</button>
        </div>
    </div>
}
