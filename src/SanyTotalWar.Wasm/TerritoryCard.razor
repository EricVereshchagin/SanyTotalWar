@using SanyTotalWar.Domain.Entities
@using SanyTotalWar.Domain.Policies
@using SanyTotalWar.Wasm.Services
@inject UiState Ui
@inject GameEngine Engine
@inject IJSRuntime Js

<div class="dossier">
    <div class="dossier-head">
        <div class="dossier-icon" style="color:@Terr.OwnerColor">
            @if (Terr.My)
            {
                <span class="tag mine">ВАША ЗЕМЛЯ</span>
            }
            <span class="dossier-name">@Terr.Name</span>
        </div>
    </div>

    <div class="stat-grid">
        <div class="stat-cell">
            <div class="stat-cell-v">@Terr.AreaKm2.ToString("0.000")</div>
            <div class="stat-cell-k">км²</div>
        </div>
        <div class="stat-cell">
            <div class="stat-cell-v">@Terr.Army<small>/@Terr.Limit</small></div>
            <div class="stat-cell-k">армия</div>
        </div>
        <div class="stat-cell @(Terr.ActiveWars > 0 ? "war" : "")">
            <div class="stat-cell-v">@(Terr.ActiveWars > 0 ? $"×{Terr.ActiveWars}" : "мир")</div>
            <div class="stat-cell-k">статус</div>
        </div>
    </div>

    <div class="army-bar"><span style="width:@Bar"></span></div>

    @if (Terr.My)
    {
        <div class="dossier-sub">ПОСТРОИТЬ · тащи карточку на карту</div>
        <div class="build-palette">
            @foreach (var spec in BuildingCatalog.All.Values)
            {
                var current = Terr.Buildings.Count(x => x.Type == spec.Type);
                var canBuild = current < spec.MaxPerTerritory && Terr.Army >= spec.Cost;
                var (svg, color) = BuildingArt.For(spec.Type);
                var pending = Ui.PendingPlacement is { } pp && pp.TerrId == Terr.Id && pp.Type == spec.Type;
                <button class="build-card @(pending ? "arming" : "")"
                        disabled="@(!canBuild)"
                        title="Тяни на карту — или кликни и укажи точку"
                        draggable="@(canBuild ? "true" : "false")" @ondragstart="() => BeginDrag(spec.Type)" @onclick="@(canBuild ? (Func<Task>)(() => BeginPlace(spec.Type)) : null)">
                    <span class="build-ico" style="color:@color">@((MarkupString)svg)</span>
                    <span class="build-name">@spec.NameRu</span>
                    <span class="build-cost">@spec.Cost</span>
                    <span class="build-desc">@spec.DescRu</span>
                    <span class="build-limit">@current/@(spec.MaxPerTerritory == int.MaxValue ? "∞" : spec.MaxPerTerritory.ToString())</span>
                </button>
            }
        </div>

        <div class="dossier-note">
            Перетащи карточку на карту и отпусти внутри этой земли — постройка встанет в точку. Или кликни по карточке и укажи место. Отменa — Esc.
        </div>
    }
    else
    {
        <div class="dossier-note">
            Земля «@Terr.OwnerName». Замкни петлю поверх неё, чтобы объявить войну за спорный участок (UC-06).
        </div>
    }
</div>

@code {
    [Parameter] public required TerrVm Terr { get; set; }

    private string Bar => Terr.Limit > 0 ? Math.Clamp(100.0 * Terr.Army / Terr.Limit, 0, 100).ToString("0") : "0";

    private async Task BeginDrag(BuildingType type) => Ui.PendingPlacement = (Terr.Id, type);

    private async Task BeginPlace(BuildingType type)
    {
        var cycle = Ui.PendingPlacement is { } pp && pp.TerrId == Terr.Id && pp.Type == type;
        Ui.PendingPlacement = cycle ? null : (Terr.Id, type);
        try { await Js.InvokeVoidAsync("sanyMap.setPlacement", Terr.Id.ToString(), CycleTypeChar(type), !cycle); }
        catch (JSDisconnectedException) { }
        catch (Exception) { }
    }

    private static string CycleTypeChar(BuildingType type) => type switch
    {
        BuildingType.ConscriptionOffice => "c",
        BuildingType.Fortress => "f",
        BuildingType.Airport => "a",
        _ => "b",
    };
}
