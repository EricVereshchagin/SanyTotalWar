@using SanyTotalWar.Domain.Entities
@using SanyTotalWar.Domain.Policies
@using SanyTotalWar.Wasm.Services
@inject UiState Ui
@inject GameEngine Engine

<div class="terr-card">
    <div class="terr-owner" style="color:@Terr.OwnerColor">
        @if (Terr.My)
        {
            <span class="tag mine">ВАША ЗЕМЛЯ</span>
        }
        <span>@Terr.OwnerName</span>
    </div>

    <div class="terr-rows">
        <div class="trow"><span>Площадь</span><b>@Terr.AreaKm2.ToString("0.000") км²</b></div>
        <div class="trow">
            <span>Армия</span>
            <b>@Terr.Army / @Terr.Limit</b>
        </div>
        <div class="army-bar"><span style="width:@Bar"></span></div>
        <div class="trow"><span>Состояние</span><b>@(Terr.ActiveWars > 0 ? $"ВОЙНА ×{Terr.ActiveWars}" : "мир (UC-01)")</b></div>
    </div>

    <div class="terr-buildings">
        @if (Terr.Buildings.Count == 0)
        {
            <div class="build-none">Построек нет (UC-13)</div>
        }
        @foreach (var b in Terr.Buildings)
        {
            <div class="build-badge">@b.NameRu</div>
        }
    </div>

    @if (Terr.My)
    {
        <div class="panel-sub">СТРОИТЬ:</div>
        <div class="build-grid">
            @foreach (var spec in BuildingCatalog.All.Values)
            {
                var current = Terr.Buildings.Count(x => x.Type == spec.Type);
                var canBuild = current < spec.MaxPerTerritory && Terr.Army >= spec.Cost;
                <button class="build-btn" disabled="@(!canBuild)" @onclick="() => Build(spec.Type)" title="@spec.DescRu">
                    <span class="bb-name">@spec.NameRu</span>
                    <span class="bb-cost">@spec.Cost</span>
                    <span class="bb-desc">@spec.DescRu</span>
                    <span class="bb-limit">@current/@(spec.MaxPerTerritory == int.MaxValue ? "∞" : spec.MaxPerTerritory.ToString())</span>
                </button>
            }
        </div>
        <div class="side-note">
            Каждый день армия тает на 5% лимита (UC-14). Казармы сокращают распад вдвое.
        </div>
    }
    else
    {
        <div class="side-note">
            Чужая земля. Замкните петлю поверх неё, чтобы объявить войну за спорный участок (UC-06).
        </div>
    }
</div>

@code {
    [Parameter] public required TerrVm Terr { get; set; }

    private string Bar => Terr.Limit > 0 ? Math.Clamp(100.0 * Terr.Army / Terr.Limit, 0, 100).ToString("0") : "0";

    private void Build(BuildingType type)
    {
        var events = Engine.Build(Ui.MeId, Terr.Id, type);
        Ui.PushToasts(events);
    }
}
