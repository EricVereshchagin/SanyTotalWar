@using SanyTotalWar.Wasm.Services
@inject UiState Ui
@inject GameEngine Engine

<div class="side panel">
    @if (World.Wars.Any(w => !w.Ended))
    {
        <div class="panel-head war-head">АКТИВНЫЕ ВОЙНЫ · @World.Wars.Count(w => !w.Ended)</div>
        @foreach (var war in World.Wars.Where(w => !w.Ended).Take(4))
        {
            <WarCard War="war" />
        }
    }
    else
    {
        <div class="panel-head">ШТАБ</div>
        <div class="side-empty">
            Тишина на фронте.<br /><br />
            Досье территории — наведи курсор на землю.<br />
            Петля маршрута — новая земля (UC-01).
        </div>
    }
</div>

@code {
    [Parameter] public required WorldVm World { get; set; }
}
