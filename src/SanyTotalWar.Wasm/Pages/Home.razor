@page "/"
@using SanyTotalWar.Application
@using SanyTotalWar.Application.Abstractions
@using SanyTotalWar.Domain
@using SanyTotalWar.Domain.Common
@using SanyTotalWar.Domain.Entities
@using SanyTotalWar.Domain.Policies
@using SanyTotalWar.Wasm.Services
@using System.Text.Json
@using System.Text.Json.Serialization
@inject GameEngine Engine
@inject IWorldRepository Repository
@inject UiState Ui
@inject IJSRuntime Js
@implements IDisposable

<div class="app-root">
    <div class="stage">
        <div id="map"></div>
        <div class="vignette"></div>

        <div class="walk-hud" id="walk-hud" style="display:none"></div>
        <div class="stage-bottom-actions">
            <button class="stage-action"
                    @onclick="@(() => ToggleList("territories"))">
                <span>⌂</span>
                Мои территории
            </button>

            <button class="stage-action"
                    @onclick="@(() => ToggleList("wars"))">
                <span>⚔</span>
                Мои войны
            </button>
        </div>

        @if (OpenPanel == "territories")
        {
            <div class="dossier-float panel stage-list">
                <div class="sheet-grab" aria-hidden="true"></div>

                <div class="stage-list-header">
                    <strong>Мои территории</strong>
                    <button class="dossier-close" title="Закрыть список"
                            @onclick="CloseList">×
                    </button>
                </div>

                @if (MyTerritories.Count == 0)
                {
                    <div class="stage-list-empty">
                        У тебя пока нет территорий.
                    </div>
                }
                else
                {
                    @foreach (var terr in MyTerritories)
                    {
                        <div @key="terr.Id" class="stage-list-item">
                            <span class="stage-list-item-title">@terr.Name</span>
                            <span class="stage-list-item-info">
                                Армия: @terr.Army / @terr.Limit
                                · @terr.AreaKm2.ToString("N2") км²
                            </span>
                            <span class="stage-list-item-info">
                                Постройки: @terr.Buildings.Count
                                · Войн: @terr.ActiveWars
                            </span>
                            <button type="button"
                                    class="stage-map-button"
                                    @onclick="() => SelectTerritoryFromList(terr.Id)">
                                <span>На карте</span>
                                <span aria-hidden="true">↗</span>
                            </button>
                        </div>
                    }
                }
            </div>
        }
        else if (OpenPanel == "wars")
        {
            <div class="dossier-float panel stage-list stage-war-list">
                <div class="sheet-grab" aria-hidden="true"></div>

                <div class="stage-list-header">
                    <strong>Мои войны</strong>
                    <button class="dossier-close" title="Закрыть список"
                            @onclick="CloseList">×
                    </button>
                </div>

                @if (MyWars.Count == 0)
                {
                    <div class="stage-list-empty">
                        Ты пока не участвуешь в активных войнах.
                    </div>
                }
                else
                {
                    @foreach (var war in MyWars)
                    {
                        <div @key="war.Id" class="stage-war-entry">
                            <WarCard War="war"/>

                            <button type="button"
                                    class="stage-map-button"
                                    @onclick="() => SelectWarFromList(war.Id)">
                                <span>На карте</span>
                                <span aria-hidden="true">↗</span>
                            </button>
                        </div>
                    }
                }
            </div>
        }
        <div class="dossier-float panel @(!IsDossierOpen ? "hidden" : "")"
             id="dossier-float">
            <div class="sheet-grab" aria-hidden="true"></div>

            @if (IsDossierOpen)
            {
                <button class="dossier-close"
                        title="Закрыть досье"
                        @onclick="CloseDossier">×
                </button>

                @if (SelectedWar is not null)
                {
                    <WarCard War="SelectedWar"/>
                }
                else if (Sel is not null)
                {
                    <TerritoryCard Terr="Sel"/>
                }
            }
        </div>

        <BriefingModal/>
    </div>

    <div class="shell">
        <TopBar World="Vm"/>
        <MobileDock World="Vm"/>
    </div>
</div>

@code {
    private DotNetObjectReference<Home>? _self;
    private WorldVm? _vm;
    private string? _pendingPayload;
    private long _pushedVersion = -1;
    private CancellationTokenSource? _cts;
    private string? OpenPanel { get; set; }
    private bool IsDossierOpen => Sel is not null;
    private WorldVm? Vm => _vm;
    private Guid? SelectedWarId { get; set; }

    private WarVm? SelectedWar =>
        SelectedWarId is { } id
            ? _vm?.Wars.FirstOrDefault(w => w.Id == id && !w.Ended)
            : null;

    private List<TerrVm> MyTerritories =>
        _vm?.Territories
            .Where(t => t.My)
            .OrderBy(t => t.Name)
            .ToList() ?? [];

    private List<WarVm> MyWars =>
        _vm?.Wars
            .Where(w => w.IAmSide && !w.Ended)
            .ToList() ?? [];

    private TerrVm? Sel => _vm?.Territories.FirstOrDefault(t => t.Id == Ui.SelectedTerritoryId);

    private void ToggleList(string name)
    {
        OpenPanel = OpenPanel == name ? null : name;
    }

    private void CloseList()
    {
        OpenPanel = null;
    }

    private async Task SelectTerritoryFromList(Guid id)
    {
        Ui.SelectedTerritoryId = id;
        SelectedWarId = null;
        OpenPanel = null;

        _vm = BuildSnapshot();
        await PushMap();

        try
        {
            await Js.InvokeVoidAsync("sanyMap.centerOnTerritory", id.ToString());
        }
        catch (JSDisconnectedException)
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectWarFromList(Guid id)
    {
        var world = Repository.World;
        Guid? territoryId;

        lock (world.Gate)
        {
            territoryId = world.Wars
                .FirstOrDefault(w => w.Id == id && !w.Ended)
                ?.ContextTerritoryId;
        }

        if (territoryId is null)
            return;

        Ui.SelectedTerritoryId = territoryId;
        SelectedWarId = id;
        OpenPanel = null;

        _vm = BuildSnapshot();
        await PushMap();

        try
        {
            await Js.InvokeVoidAsync("sanyMap.centerOnWar", id.ToString());
        }
        catch (JSDisconnectedException)
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseDossier()
    {
        Ui.SelectedTerritoryId = null;
        SelectedWarId = null;

        _vm = BuildSnapshot();
        await PushMap();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnMapClicked()
    {
        Ui.SelectedTerritoryId = null;
        SelectedWarId = null;

        _vm = BuildSnapshot();
        await PushMap();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        _vm = BuildSnapshot();
        _self = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("sanyMap.init", _self, new
            {
                lat = WorldSeeder.Center.Lat,
                lng = WorldSeeder.Center.Lng,
                zoom = 15
            });
            _vm = BuildSnapshot();
            await PushMap();
            _cts = new CancellationTokenSource();
            _ = PulseLoop(_cts.Token);
        }
    }

    private async Task PulseLoop(CancellationToken ct)
    {
        var lastTickUtc = DateTime.UtcNow;
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(400));
        while (await timer.WaitForNextTickAsync(ct))
        {
            try
            {
                var nowUtc = DateTime.UtcNow;
                var dt = nowUtc - lastTickUtc;
                lastTickUtc = nowUtc;
                if (dt > TimeSpan.FromSeconds(2)) dt = TimeSpan.FromSeconds(2);
                Engine.Tick(TimeSpan.FromSeconds(dt.TotalSeconds * Ui.GameSpeed));

                Ui.TickToasts();
                _vm = BuildSnapshot();
                await InvokeAsync(StateHasChanged);
                if (_vm is not null && _vm.Version != _pushedVersion && _pendingPayload is not null)
                    await PushMap();
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch (Exception)
            {
                /* keep the pulse alive */
            }
        }
    }

    private WorldVm BuildSnapshot()
    {
        var world = Repository.World;
        lock (world.Gate)
        {
            // свои земли всегда в фосфорном акценте интерфейса
            const string mineColor = "#c6f24e";
            var meId = Ui.MeId;
            var me = world.PlayerById(meId)!;
            var terrs = new List<TerrVm>();
            foreach (var t in world.Territories)
            {
                var owner = world.PlayerById(t.OwnerId);
                var activeWars = world.ActiveWars.Count(w => w.ContextTerritoryId == t.Id);
                terrs.Add(new TerrVm(
                    t.Id, t.Name, t.OwnerId, owner?.Name ?? "?",
                    t.OwnerId == meId ? mineColor : owner?.ColorHex ?? "#999",
                    t.OwnerId == meId, Engine.AreaKm2(t), Engine.ArmyLimitOf(t), t.Army,
                    t.Buildings.Select(b => BuildingCatalog.All[b.Type]).ToList(),
                    activeWars, t.Id == Ui.SelectedTerritoryId));
            }

            var wars = new List<WarVm>();
            foreach (var w in world.Wars.OrderByDescending(w => !w.Ended).ThenByDescending(w => w.StartedAtGameTime))
            {
                var sides = new List<SideVm>();
                foreach (var s in w.Sides)
                {
                    var possible = Math.Max(1, w.PointsPerCycle * Math.Max(1, w.CyclesGenerated));
                    var myPts = w.Points.Count(p => p.CapturedBy == s.PlayerId);
                    var all = w.Sides.Sum(x => x.Mobilized);
                    var (h, sc, c) = ControlPolicy.Score(myPts, possible, s.Mobilized, all);
                    var p = world.PlayerById(s.PlayerId);
                    sides.Add(new SideVm(p?.Name ?? "?",
                        s.PlayerId == meId ? "#c6f24e" : p?.ColorHex ?? "#999",
                        s.Mobilized, h, sc, c, s.PlayerId == meId));
                }

                var mySide = w.SideOf(meId);
                var minutesLeft = w.Ended
                    ? 0
                    : (int)Math.Max(0, (w.LastJoinAtGameTime + WarPolicy.JoinRestart - world.GameNow).TotalMinutes);
                wars.Add(new WarVm(
                    w.Id, w.ContextTerritoryId, w.Name, w.ZoneAreaKm2, sides, minutesLeft,
                    w.Points.Count(p => p.CapturedBy == meId),
                    w.PointsPerCycle * Math.Max(1, w.CyclesGenerated),
                    mySide is not null, mySide?.Mobilized ?? 0,
                    w.Ended, w.WinnerId is null ? null : world.PlayerById(w.WinnerId.Value)?.Name, w.EndReason));
            }

            var myTerrs = terrs.Where(t => t.My).ToList();

            var vm = new WorldVm(
                world.Version, world.GameNow, terrs, wars,
                world.JournalSnapshot().Select(j => new JournalVm(j.GameTime, j.Kind, j.Message)).ToList(),
                myTerrs.Sum(t => t.Army),
                myTerrs.Sum(t => t.AreaKm2),
                myTerrs.Sum(t => t.Limit),
                meId,
                wars.Count(w => w.IAmSide && !w.Ended));

            _pendingPayload = BuildPayloadCore(world, vm);
            return vm;
        }
    }

    private async Task PushMap()
    {
        var payload = _pendingPayload;
        if (payload is null || _vm is null) return;
        _pushedVersion = _vm.Version;
        _pendingPayload = null;
        try
        {
            await Js.InvokeVoidAsync("sanyMap.pushState", payload);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception)
        {
            /* retry on the next pulse */
        }
    }

    private string BuildPayloadCore(World world, WorldVm vm)
    {
        var options = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
        var colors = world.Players.ToDictionary(p => p.Id, p => p.ColorHex);

        var territoryDtos = world.Territories.Select(t => new
        {
            id = t.Id,
            name = t.Name,
            color = t.OwnerId == vm.MyId ? "#c6f24e" : colors.GetValueOrDefault(t.OwnerId, "#999"),
            mine = t.OwnerId == vm.MyId,
            owner = world.PlayerById(t.OwnerId)?.Name ?? "?",
            area = Math.Round(Engine.AreaKm2(t), 4),
            army = t.Army,
            limit = Engine.ArmyLimitOf(t),
            selected = t.Id == Ui.SelectedTerritoryId,
            parts = t.Parts
                .Where(p => p.Exterior.Count >= 3)
                .Select(p => RingsOf(new List<List<GeoPoint>> { p.Exterior }.Concat(p.Holes)))
                .ToList(),
            buildings = t.Buildings.Select(b => new
            {
                t = b.Type switch
                {
                    BuildingType.ConscriptionOffice => "c",
                    BuildingType.Fortress => "f",
                    BuildingType.Airport => "a",
                    _ => "b"
                },
                lat = b.Position?.Lat,
                lng = b.Position?.Lng,
            }).ToList(),
        }).ToList();

        var wars = world.Wars.Where(w => !w.Ended).Select(w => new
        {
            id = w.Id,
            contextTerritoryId = w.ContextTerritoryId,
            rings = RingsOf(w.ZoneParts.Select(p => p.Exterior)),
            points = w.Points.Select(p => new
            {
                lat = p.Position.Lat,
                lng = p.Position.Lng,
                by = p.CapturedBy,
                color = p.CapturedBy is null ? null : colors.GetValueOrDefault(p.CapturedBy.Value, "#999")
            }).ToList()
        }).ToList();

        var tracks = world.RecentTracks
            .Where(t => world.GameNow - t.AtGameTime <= TimeSpan.FromHours(3) && t.Points.Count >= 2)
            .Select(t => new
            {
                color = colors.GetValueOrDefault(t.PlayerId, "#999"),
                loop = t.Loop,
                pts = t.Points.Select(p => new[] { p.Lat, p.Lng }).ToList()
            })
            .ToList();

        var dto = new { version = vm.Version, territories = territoryDtos, wars, tracks, sel = Ui.SelectedTerritoryId?.ToString() ?? "" };
        return JsonSerializer.Serialize(dto, options);
    }

    private static List<double[][]> RingsOf(IEnumerable<List<GeoPoint>> rings) => rings
        .Where(r => r.Count >= 3)
        .Select(r => r.Select(p => new[] { p.Lat, p.Lng }).ToArray())
        .ToList();

    [JSInvokable]
    public async Task OnTrackCompleted(double[][] points)
    {
        var pts = points.Select(a => new GeoPoint(a[0], a[1])).ToList();
        var events = Engine.AddTrack(Ui.MeId, pts);
        Ui.PushToasts(events);
        _vm = BuildSnapshot();
        await PushMap();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnBuildingDropped(double lat, double lng)
    {
        if (Ui.PendingPlacement is not { } pending) return;
        Ui.PendingPlacement = null;
        try
        {
            await Js.InvokeVoidAsync("sanyMap.setPlacement", "", "", false);
        }
        catch (JSDisconnectedException)
        {
        }

        var events = Engine.Build(Ui.MeId, pending.TerrId, pending.Type, new GeoPoint(lat, lng));
        Ui.PushToasts(events);
        _vm = BuildSnapshot();
        await PushMap();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnPlacementCancelled()
    {
        Ui.PendingPlacement = null;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnTerritoryClicked(string idStr)
    {
        SelectedWarId = null;

        if (Guid.TryParse(idStr, out var id))
            Ui.SelectedTerritoryId = id == Ui.SelectedTerritoryId ? null : id;

        _vm = BuildSnapshot();
        await PushMap();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnWarClicked(string territoryIdStr, string warIdStr)
    {
        if (Guid.TryParse(territoryIdStr, out var territoryId) &&
            Guid.TryParse(warIdStr, out var warId))
        {
            Ui.SelectedTerritoryId = territoryId;
            SelectedWarId = warId;
        }

        _vm = BuildSnapshot();
        await PushMap();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _self?.Dispose();
    }

}
