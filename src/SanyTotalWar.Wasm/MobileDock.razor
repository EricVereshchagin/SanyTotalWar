@using SanyTotalWar.Wasm.Services
@inject UiState Ui

<div class="dock @(Ui.DockOpen ? "" : "collapsed")">
    <MapFab />

    <div class="dock-tabs" title="Свернуть/развернуть" @onclick="() => Ui.DockOpen = !Ui.DockOpen">
        <span class="dock-chev @(Ui.DockOpen ? "" : "up")" aria-hidden="true"></span>
        <button class="dock-tab on" @onclick='() => SetTab("wars")' @onclick:stopPropagation="true">
            ВОЙНЫ<span class="n">@ActiveWars</span>
        </button>
    </div>

    <div class="dock-body">
        @if (ActiveWars > 0)
        {
            foreach (var war in World.Wars.Where(w => !w.Ended).Take(4))
            {
                <WarCard War="war" />
            }
        }
        else
        {
            <div class="dock-empty">Нету войн. Замкни петлю поверх чужой земли, чтобы объявить войну (UC-06).</div>
        }
    </div>
</div>

@code {
    [Parameter] public required WorldVm World { get; set; }

    private int ActiveWars => World.Wars.Count(w => !w.Ended);

    private void SetTab(string tab)
    {
        Ui.DockTab = tab;
        Ui.DockOpen = true;
    }
}
